# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Sheets Database Configuration
GOOGLE_SHEETS_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Authentication Secret
JWT_SECRET="sijaka-super-secret-jwt-key-2026"

